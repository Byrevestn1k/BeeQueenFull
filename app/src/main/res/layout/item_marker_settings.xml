<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="10dp">

    <!-- Header: checkbox + title + color preview -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <CheckBox
            android:id="@+id/checkEnabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Увімкнено"
            android:checked="false"/>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textStyle="bold"
            android:textSize="16sp"
            android:paddingStart="6dp" />

        <!-- Color preview -->
        <View
            android:id="@+id/viewColorPreview"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_color_preview" />
    </LinearLayout>

    <!-- Confidence label -->
    <TextView
        android:id="@+id/tvConfidence"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Впевненість: 25%"
        android:textSize="13sp"
        android:layout_marginTop="6dp" />

    <!-- Confidence min/max -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10%"
            android:textSize="12sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="90%"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Confidence seekbar -->
    <SeekBar
        android:id="@+id/seekThreshold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="80" />

    <!-- Color label -->
    <TextView
        android:id="@+id/tvColorLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Колір рамки"
        android:textSize="13sp"
        android:layout_marginTop="6dp" />

    <!-- Color seekbar container (тонка лінія + великий thumb) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp">

        <SeekBar
            android:id="@+id/seekColor"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_gravity="center_vertical"
            android:max="360"
            android:splitTrack="false"
            android:thumb="@drawable/gradient_thumb"
            android:thumbOffset="0dp" />
    </FrameLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="#444444" />

</LinearLayout>
